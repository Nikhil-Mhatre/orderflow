
aws_region   = "us-east-1"
project_name = "orderflow"
environment  = "dev"

vpc_cidr = "10.40.0.0/16"

# Empty means Terraform selects the first two available AZs.
availability_zones = []

public_subnet_cidrs = [
  "10.40.101.0/24",
  "10.40.102.0/24"
]

private_subnet_cidrs = [
  "10.40.1.0/24",
  "10.40.2.0/24"
]

# Keep false for low-cost initial testing.
enable_nat_gateway = true
single_nat_gateway = true

ecr_repository_names = [
  "frontend",
  "api",
  "worker"
]

ecr_max_image_count = 30

subject_claim_prefix = <GET_IT_FROM_GITHUB_REPO_SETTINGS>
github_deploy_branch = "main"


# Set this to a tested, pinned chart version from the argo-helm repository.
argocd_chart_version = "10.11.1"

gitops_repo_url = "https://github.com/YOUR_ORG/YOUR_GITOPS_REPO.git"
gitops_revision = "main"
gitops_path     = "environments/dev"



tags = {
  ManagedBy   = "Terraform"
}

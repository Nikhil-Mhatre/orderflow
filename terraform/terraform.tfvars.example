aws_region   = "ap-south-1"
project_name = "order-flow"
environment  = "dev"

# Required: set these to your actual GitHub owner and repository.
github_org  = "YOUR_GITHUB_ORG_OR_USERNAME"
github_repo = "order-flow"

# Restrict this to your trusted public IP/CIDR before applying.
# Example: ["203.0.113.10/32"]
eks_public_access_cidrs = ["0.0.0.0/0"]

# Dev defaults are cost-conscious, not production HA.
single_nat_gateway = true
db_multi_az        = false

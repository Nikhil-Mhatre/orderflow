# EXAMPLE ONLY: adapt to the actual package layout and runtime before use.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app app
COPY --from=build --chown=app:app /app/package.json ./package.json
COPY --from=build --chown=app:app /app/node_modules ./node_modules
COPY --from=build --chown=app:app /app/dist ./dist
COPY --from=build --chown=app:app /app/src/db/migrations ./src/db/migrations
COPY --from=build --chown=app:app /app/drizzle.config.ts ./drizzle.config.ts
USER app
# Replace with a project-owned runner that invokes Drizzle migrate and uses
# the committed migration directory. Confirm pnpm is available if using pnpm here.
CMD ["pnpm", "db:migrate"]

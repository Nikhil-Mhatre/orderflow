# Application environment
NODE_ENV=development

# AWS configuration
AWS_REGION=ap-south-1

# SQS queue consumed by the Order Worker
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/000000000000/orderflow-order-processing

# PostgreSQL
#
# Local Docker Compose uses the postgres service name instead of localhost.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/orderflow

# Service metadata
SERVICE_NAME=orderflow-order-worker
SERVICE_VERSION=0.0.0

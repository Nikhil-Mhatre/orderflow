# Application
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://orderflow_user:orderflow-local-password@postgres:5432/orderflow

# PostgreSQL container configuration
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow_user
POSTGRES_PASSWORD=orderflow-local-password
POSTGRES_PORT=5432

# AWS
AWS_REGION=ap-south-1

# EventBridge
EVENT_BUS_NAME=orderflow

# Application metadata
SERVICE_NAME=orderflow-order-api
SERVICE_VERSION=0.1.0

# Use a current LTS Node.js image for local development.
FROM node:24-bookworm-slim

# Enable pnpm through Corepack.
RUN corepack enable

# Keep the application inside a predictable working directory.
WORKDIR /workspace

# Copy workspace manifests first.
#
# Docker can cache dependency installation as long as these files don't
# change. Source-code changes will therefore not reinstall dependencies.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./

# Copy package manifests for the workspace packages required by order-api.
COPY apps/order-api/package.json apps/order-api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json

# Install the complete workspace dependency graph.
#
# The workspace packages are copied above because pnpm needs their manifests
# to resolve workspace:* dependencies correctly.
RUN pnpm install --frozen-lockfile

# Copy the source/configuration required by the Order API.
COPY apps/order-api apps/order-api

# Copy shared configuration packages used by the Order API.
COPY packages/eslint-config packages/eslint-config
COPY packages/contracts packages/contracts
COPY packages/typescript-config packages/typescript-config

# Build shared contracts before starting the Order API.
#
# @orderflow/contracts exposes compiled files from dist through its
# package.json exports. The Order API therefore needs the contracts
# package to be built before tsx starts the application.
RUN pnpm --filter @orderflow/contracts build

# Order API listens on port 3001 by default.
EXPOSE 3001

# Development command.
#
# tsx watch runs the TypeScript application directly and restarts it when
# source files change.
CMD ["pnpm", "--filter", "@orderflow/order-api", "dev"]

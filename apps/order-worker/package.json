{
  "name": "@orderflow/order-worker",
  "version": "0.1.0",
  "private": true,
  "description": "OrderFlow order worker service",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orderflow/eslint-config": "workspace:*",
    "@orderflow/typescript-config": "workspace:*",
    "@orderflow/contracts": "workspace:*",
    "@aws-sdk/client-secrets-manager": "^3.1133.0",
    "@aws-sdk/client-sqs": "^3.1133.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
